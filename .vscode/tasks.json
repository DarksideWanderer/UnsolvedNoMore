//这个是启动构建任务的配置文件
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile",//用于简单编译单文件
            "command": "C:/Users/17269/Desktop/Package/Msys2/mingw64/bin/g++.exe",
            "args": [
                "''$(cygpath -u '${file}')''",
				"-std=c++26",
				"-g",
				"-Wall",
                "-o",
                "''$(cygpath -u '${fileDirname}/${fileBasenameNoExtension}')''"
            ],
            "type": "shell",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        },
		{
			"label": "CMake Build",//用于执行 Cmake
			"type": "shell",
			"command": "C:/Users/17269/Desktop/Package/Msys2/mingw64/bin/cmake.exe",
			"args": [
				"--build",
				"''$(cygpath -u '${workspaceFolder}/build')''"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}